Функция КоличествоПоЗапросу(ТекстЗапроса)
    Запрос = Новый Запрос(ТекстЗапроса);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        Возврат 0;
    КонецЕсли;
    Возврат Выборка.Количество;
КонецФункции

Процедура ПроверитьСправочники()
    Имена = Новый Массив;
    Имена.Добавить("Гости");
    Имена.Добавить("КатегорииНомеров");
    Имена.Добавить("Номера");
    Имена.Добавить("ДополнительныеУслуги");
    Имена.Добавить("Сотрудники");
    Имена.Добавить("Тарифы");
    Имена.Добавить("ИсточникиБронирования");
    Для Каждого Имя Из Имена Цикл
        Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник." + Имя + " КАК С ГДЕ НЕ С.ПометкаУдаления";
        Количество = КоличествоПоЗапросу(Текст);
        Если Количество <> 5 Тогда
            ВызватьИсключение "TEST_DATA_" + Имя + "=" + Строка(Количество);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьАвтосумму()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Б.КоличествоСуток КАК КоличествоСуток,
    |   Б.СтоимостьСуток КАК СтоимостьСуток,
    |   Б.СуммаПроживания КАК СуммаПроживания,
    |   Б.СуммаДополнительныхУслуг КАК СуммаДополнительныхУслуг,
    |   Б.ИтоговаяСумма КАК ИтоговаяСумма
    |ИЗ
    |   Документ.БронированиеНомера КАК Б
    |ГДЕ
    |   НЕ Б.ПометкаУдаления
    |   И Б.Комната.Наименование = ""301""";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "AUTOSUM_SAMPLE_MISSING";
    КонецЕсли;
    Если Выборка.КоличествоСуток <> 4
        Или Выборка.СтоимостьСуток <> 10000
        Или Выборка.СуммаПроживания <> 40000
        Или Выборка.СуммаДополнительныхУслуг <> 0
        Или Выборка.ИтоговаяСумма <> 40000 Тогда
        ВызватьИсключение "AUTOSUM_VALUES_FAIL";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   КОЛИЧЕСТВО(*) КАК Количество,
    |   СУММА(У.ИтоговаяСумма) КАК Сумма
    |ИЗ
    |   Документ.ОказаниеУслуг КАК У
    |ГДЕ
    |   НЕ У.ПометкаУдаления";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Если Выборка.Количество <> 5 Или Выборка.Сумма <> 7000 Тогда
        ВызватьИсключение "AUTOSUM_SERVICES_FAIL";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПорог()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   МАКСИМУМ(Б.ИтоговаяСумма) КАК Максимум
    |ИЗ
    |   Документ.БронированиеНомера КАК Б
    |ГДЕ
    |   НЕ Б.ПометкаУдаления";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Если Выборка.Максимум <= 30000 Тогда
        ВызватьИсключение "THRESHOLD_SAMPLE_FAIL";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПересечениеБрони()
    ДоПроверки = КоличествоПоЗапросу("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.БронированиеНомера КАК Б ГДЕ НЕ Б.ПометкаУдаления");
    Док = Документы.БронированиеНомера.СоздатьДокумент();
    Док.Дата = Дата(2026, 11, 28, 12, 0, 0);
    Док.Гость = Справочники.Гости.НайтиПоНаименованию("Иванов Алексей", Истина);
    Док.Комната = Справочники.Номера.НайтиПоНаименованию("101", Истина);
    Док.ДатаЗаезда = Дата(2026, 11, 9);
    Док.ДатаВыезда = Дата(2026, 11, 11);
    Док.Тариф = Справочники.Тарифы.НайтиПоНаименованию("Базовый", Истина);
    Док.СтатусБронирования = Перечисления.СтатусыБронирования.Подтверждено;
    Попытка
        Док.Записать();
    Исключение
    КонецПопытки;
    ПослеПроверки = КоличествоПоЗапросу("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.БронированиеНомера КАК Б ГДЕ НЕ Б.ПометкаУдаления");
    Если ПослеПроверки <> ДоПроверки Тогда
        ВызватьИсключение "BOOKING_VALIDATION_OVERLAP_FAIL";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьНекорректныеДаты()
    ДоПроверки = КоличествоПоЗапросу("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.БронированиеНомера КАК Б ГДЕ НЕ Б.ПометкаУдаления");
    Док = Документы.БронированиеНомера.СоздатьДокумент();
    Док.Дата = Дата(2026, 11, 28, 12, 0, 0);
    Док.Гость = Справочники.Гости.НайтиПоНаименованию("Соколова Мария", Истина);
    Док.Комната = Справочники.Номера.НайтиПоНаименованию("102", Истина);
    Док.ДатаЗаезда = Дата(2026, 12, 20);
    Док.ДатаВыезда = Дата(2026, 12, 20);
    Док.Тариф = Справочники.Тарифы.НайтиПоНаименованию("Базовый", Истина);
    Док.СтатусБронирования = Перечисления.СтатусыБронирования.Создано;
    Попытка
        Док.Записать();
    Исключение
    КонецПопытки;
    ПослеПроверки = КоличествоПоЗапросу("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.БронированиеНомера КАК Б ГДЕ НЕ Б.ПометкаУдаления");
    Если ПослеПроверки <> ДоПроверки Тогда
        ВызватьИсключение "BOOKING_VALIDATION_DATES_FAIL";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОплаты()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   КОЛИЧЕСТВО(*) КАК Количество,
    |   СУММА(О.СуммаОплаты) КАК СуммаОплаты
    |ИЗ
    |   Документ.Оплата КАК О
    |ГДЕ
    |   НЕ О.ПометкаУдаления";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Если Выборка.Количество <> 5 Или Выборка.СуммаОплаты <> 51150 Тогда
        ВызватьИсключение "PAYMENT_ACCOUNTING_FAIL";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтчетЗаПериод()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   КОЛИЧЕСТВО(*) КАК Количество,
    |   СУММА(Б.ИтоговаяСумма + ЕСТЬNULL(У.Сумма, 0)) КАК Начислено,
    |   СУММА(ЕСТЬNULL(О.Сумма, 0)) КАК Оплачено,
    |   СУММА(Б.ИтоговаяСумма + ЕСТЬNULL(У.Сумма, 0) - ЕСТЬNULL(О.Сумма, 0)) КАК Задолженность
    |ИЗ
    |   Документ.БронированиеНомера КАК Б
    |       ЛЕВОЕ СОЕДИНЕНИЕ
    |           (ВЫБРАТЬ
    |               Бронирование,
    |               СУММА(ИтоговаяСумма) КАК Сумма
    |            ИЗ Документ.ОказаниеУслуг
    |            ГДЕ НЕ ПометкаУдаления И Дата <= &КонецПериода
    |            СГРУППИРОВАТЬ ПО Бронирование) КАК У
    |       ПО Б.Ссылка = У.Бронирование
    |       ЛЕВОЕ СОЕДИНЕНИЕ
    |           (ВЫБРАТЬ
    |               Бронирование,
    |               СУММА(СуммаОплаты) КАК Сумма
    |            ИЗ Документ.Оплата
    |            ГДЕ НЕ ПометкаУдаления И Дата <= &КонецПериода
    |            СГРУППИРОВАТЬ ПО Бронирование) КАК О
    |       ПО Б.Ссылка = О.Бронирование
    |ГДЕ
    |   НЕ Б.ПометкаУдаления
    |   И Б.СтатусБронирования <> ЗНАЧЕНИЕ(Перечисление.СтатусыБронирования.Отменено)
    |   И Б.ДатаЗаезда МЕЖДУ &НачалоПериода И &КонецПериода";
    Запрос.УстановитьПараметр("НачалоПериода", Дата(2026, 11, 1, 0, 0, 0));
    Запрос.УстановитьПараметр("КонецПериода", КонецДня(Дата(2026, 11, 30, 0, 0, 0)));
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Если Выборка.Количество <> 5
        Или Выборка.Начислено <> 109300
        Или Выборка.Оплачено <> 51150
        Или Выборка.Задолженность <> 58150 Тогда
        ВызватьИсключение "PERIOD_REPORT_FAIL";
    КонецЕсли;
КонецПроцедуры


Функция ДорогаяБронь() Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Б.Ссылка КАК Ссылка
    |ИЗ
    |   Документ.БронированиеНомера КАК Б
    |ГДЕ
    |   НЕ Б.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |   Б.ИтоговаяСумма УБЫВ";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция ДорогаяБроньССообщением() Экспорт
    Ссылка = ДорогаяБронь();
    Если Ссылка = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Объект = Ссылка.ПолучитьОбъект();
    Объект.Записать();
    Возврат Ссылка;
КонецФункции

Функция ПервоеОказаниеУслуг() Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   У.Ссылка КАК Ссылка
    |ИЗ
    |   Документ.ОказаниеУслуг КАК У
    |ГДЕ
    |   НЕ У.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО У.Дата";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция Выполнить() Экспорт
    ПроверитьСправочники();
    ПроверитьАвтосумму();
    ПроверитьПорог();
    ПроверитьПересечениеБрони();
    ПроверитьНекорректныеДаты();
    ПроверитьОплаты();
    ПроверитьОтчетЗаПериод();
    Возврат "TEST_DATA=PASS;AUTOSUM=PASS;THRESHOLD_LOGIC=PASS;BOOKING_VALIDATION=PASS;PAYMENT_ACCOUNTING=PASS;PERIOD_REPORT=PASS";
КонецФункции
