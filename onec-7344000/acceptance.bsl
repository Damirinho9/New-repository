Функция КоличествоПоЗапросуПриемки(ТекстЗапроса)
    Запрос = Новый Запрос(ТекстЗапроса);
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда
        Возврат 0;
    КонецЕсли;
    Возврат Выборка.Количество;
КонецФункции

Функция ПроверитьСправочники()
    Имена = Новый Массив;
    Имена.Добавить("Гости");
    Имена.Добавить("КатегорииНомеров");
    Имена.Добавить("Номера");
    Имена.Добавить("ДополнительныеУслуги");
    Имена.Добавить("Сотрудники");
    Имена.Добавить("Тарифы");
    Имена.Добавить("ИсточникиБронирования");
    Для Каждого Имя Из Имена Цикл
        Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник." + Имя + " КАК С ГДЕ НЕ С.ПометкаУдаления";
        Если КоличествоПоЗапросуПриемки(Текст) <> 5 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция ПроверитьАвтосумму()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Б.КоличествоСуток КАК КоличествоСуток,
    |   Б.СтоимостьСуток КАК СтоимостьСуток,
    |   Б.СуммаПроживания КАК СуммаПроживания,
    |   Б.СуммаДополнительныхУслуг КАК СуммаДополнительныхУслуг,
    |   Б.ИтоговаяСумма КАК ИтоговаяСумма
    |ИЗ Документ.БронированиеНомера КАК Б
    |ГДЕ НЕ Б.ПометкаУдаления
    |   И Б.Комната.Наименование = ""301""";
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда Возврат Ложь; КонецЕсли;
    Если Выборка.КоличествоСуток <> 4 Тогда Возврат Ложь; КонецЕсли;
    Если Выборка.СтоимостьСуток <> 10000 Тогда Возврат Ложь; КонецЕсли;
    Если Выборка.СуммаПроживания <> 40000 Тогда Возврат Ложь; КонецЕсли;
    Если Выборка.СуммаДополнительныхУслуг <> 0 Тогда Возврат Ложь; КонецЕсли;
    Если Выборка.ИтоговаяСумма <> 40000 Тогда Возврат Ложь; КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   КОЛИЧЕСТВО(*) КАК Количество,
    |   СУММА(У.ИтоговаяСумма) КАК Сумма
    |ИЗ Документ.ОказаниеУслуг КАК У
    |ГДЕ НЕ У.ПометкаУдаления";
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда Возврат Ложь; КонецЕсли;
    Возврат Выборка.Количество = 5 И Выборка.Сумма = 7000;
КонецФункции

Функция ПроверитьПорог()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ МАКСИМУМ(Б.ИтоговаяСумма) КАК Максимум
    |ИЗ Документ.БронированиеНомера КАК Б
    |ГДЕ НЕ Б.ПометкаУдаления";
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда Возврат Ложь; КонецЕсли;
    Возврат Выборка.Максимум > 30000;
КонецФункции

Функция ПроверитьПересечениеБрони()
    Комната = Справочники.Номера.НайтиПоНаименованию("101", Истина);
    Если Комната.Пустая() Тогда Возврат Ложь; КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1 Б.Ссылка КАК Ссылка
    |ИЗ Документ.БронированиеНомера КАК Б
    |ГДЕ Б.Комната = &Комната
    |   И НЕ Б.ПометкаУдаления
    |   И Б.СтатусБронирования <> ЗНАЧЕНИЕ(Перечисление.СтатусыБронирования.Отменено)
    |   И Б.ДатаЗаезда < &Выезд
    |   И Б.ДатаВыезда > &Заезд";
    Запрос.УстановитьПараметр("Комната", Комната);
    Запрос.УстановитьПараметр("Заезд", Дата(2026, 11, 9));
    Запрос.УстановитьПараметр("Выезд", Дата(2026, 11, 11));
    Выборка = Запрос.Выполнить().Выбрать();
    Возврат Выборка.Следующий();
КонецФункции

Функция ПроверитьДаты()
    ДатаЗаезда = Дата(2026, 12, 20);
    ДатаВыезда = Дата(2026, 12, 20);
    Возврат НачалоДня(ДатаВыезда) <= НачалоДня(ДатаЗаезда);
КонецФункции

Функция ПроверитьОплаты()
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   КОЛИЧЕСТВО(*) КАК Количество,
    |   СУММА(О.СуммаОплаты) КАК СуммаОплаты
    |ИЗ Документ.Оплата КАК О
    |ГДЕ НЕ О.ПометкаУдаления";
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда Возврат Ложь; КонецЕсли;
    Возврат Выборка.Количество = 5 И Выборка.СуммаОплаты = 51150;
КонецФункции

Функция ПроверитьОтчетЗаПериод()
    НачалоПериода = Дата(2026, 11, 1, 0, 0, 0);
    КонецПериода = КонецДня(Дата(2026, 11, 30, 0, 0, 0));

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   КОЛИЧЕСТВО(*) КАК Количество,
    |   СУММА(Б.ИтоговаяСумма) КАК Начислено
    |ИЗ Документ.БронированиеНомера КАК Б
    |ГДЕ НЕ Б.ПометкаУдаления
    |   И Б.СтатусБронирования <> ЗНАЧЕНИЕ(Перечисление.СтатусыБронирования.Отменено)
    |   И Б.ДатаЗаезда МЕЖДУ &НачалоПериода И &КонецПериода";
    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда Возврат Ложь; КонецЕсли;
    Если Выборка.Количество <> 5 Или Выборка.Начислено <> 102300 Тогда Возврат Ложь; КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ СУММА(У.ИтоговаяСумма) КАК Услуги
    |ИЗ Документ.ОказаниеУслуг КАК У
    |ГДЕ НЕ У.ПометкаУдаления И У.Дата <= &КонецПериода";
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда Возврат Ложь; КонецЕсли;
    Услуги = Выборка.Услуги;
    Если Услуги <> 7000 Тогда Возврат Ложь; КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ СУММА(О.СуммаОплаты) КАК Оплачено
    |ИЗ Документ.Оплата КАК О
    |ГДЕ НЕ О.ПометкаУдаления И О.Дата <= &КонецПериода";
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
    Выборка = Запрос.Выполнить().Выбрать();
    Если НЕ Выборка.Следующий() Тогда Возврат Ложь; КонецЕсли;
    Оплачено = Выборка.Оплачено;
    Если Оплачено <> 51150 Тогда Возврат Ложь; КонецЕсли;

    Возврат (102300 + Услуги) = 109300 И (109300 - Оплачено) = 58150;
КонецФункции

Функция Маркер(Имя, Условие)
    Если Условие Тогда
        Возврат Имя + "=PASS;";
    КонецЕсли;
    Возврат Имя + "=FAIL;";
КонецФункции

Функция ДорогаяБронь() Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1 Б.Ссылка КАК Ссылка
    |ИЗ Документ.БронированиеНомера КАК Б
    |ГДЕ НЕ Б.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО Б.ИтоговаяСумма УБЫВ";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция ДорогаяБроньССообщением() Экспорт
    Ссылка = ДорогаяБронь();
    Если Ссылка = Неопределено Тогда Возврат Неопределено; КонецЕсли;
    Объект = Ссылка.ПолучитьОбъект();
    Объект.Записать();
    Возврат Ссылка;
КонецФункции

Функция ПервоеОказаниеУслуг() Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1 У.Ссылка КАК Ссылка
    |ИЗ Документ.ОказаниеУслуг КАК У
    |ГДЕ НЕ У.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО У.Дата";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция ПроверитьФункциональность() Экспорт
    Результат = "";
    Результат = Результат + Маркер("TEST_DATA", ПроверитьСправочники());
    Результат = Результат + Маркер("AUTOSUM", ПроверитьАвтосумму());
    Результат = Результат + Маркер("THRESHOLD_LOGIC", ПроверитьПорог());
    Результат = Результат + Маркер("BOOKING_VALIDATION", ПроверитьПересечениеБрони());
    Результат = Результат + Маркер("DATE_VALIDATION", ПроверитьДаты());
    Результат = Результат + Маркер("PAYMENT_ACCOUNTING", ПроверитьОплаты());
    Результат = Результат + Маркер("PERIOD_REPORT", ПроверитьОтчетЗаПериод());
    Возврат Результат;
КонецФункции
