Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Если Не ЗначениеЗаполнено(Гость) Или Не ЗначениеЗаполнено(Номер) Или Не ЗначениеЗаполнено(Тариф) Тогда
        Сообщить("Укажите гостя, номер и тариф.");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ДатаЗаезда) Или Не ЗначениеЗаполнено(ДатаВыезда) Или НачалоДня(ДатаВыезда) <= НачалоДня(ДатаЗаезда) Тогда
        Сообщить("Дата выезда должна быть позднее даты заезда.");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    Если СтатусБронирования.Пустая() Тогда
        СтатусБронирования = Перечисления.СтатусыБронирования.Создано;
    КонецЕсли;
    Если СтатусБронирования <> Перечисления.СтатусыБронирования.Отменено Тогда
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Б.Ссылка
        |ИЗ Документ.БронированиеНомера КАК Б
        |ГДЕ Б.Номер = &Номер И Б.Ссылка <> &Ссылка
        |И НЕ Б.ПометкаУдаления
        |И Б.СтатусБронирования <> ЗНАЧЕНИЕ(Перечисление.СтатусыБронирования.Отменено)
        |И Б.ДатаЗаезда < &Выезд И Б.ДатаВыезда > &Заезд";
        Запрос.УстановитьПараметр("Номер", Номер);
        Запрос.УстановитьПараметр("Ссылка", Ссылка);
        Запрос.УстановитьПараметр("Заезд", НачалоДня(ДатаЗаезда));
        Запрос.УстановитьПараметр("Выезд", НачалоДня(ДатаВыезда));
        Если Не Запрос.Выполнить().Пустой() Тогда
            Сообщить("Номер уже забронирован на указанные даты.");
            Отказ = Истина;
            Возврат;
        КонецЕсли;
    КонецЕсли;
    КоличествоСуток = (НачалоДня(ДатаВыезда) - НачалоДня(ДатаЗаезда)) / 86400;
    СтоимостьСуток = Окр(Номер.Категория.СтоимостьСуток * Тариф.Коэффициент, 2);
    СуммаПроживания = КоличествоСуток * СтоимостьСуток;
    СуммаДополнительныхУслуг = 0;
    Для Каждого СтрокаУслуги Из Услуги Цикл
        Если Не ЗначениеЗаполнено(СтрокаУслуги.Услуга) Или СтрокаУслуги.Количество <= 0 Тогда
            Сообщить("Укажите услугу и положительное количество.");
            Отказ = Истина;
            Возврат;
        КонецЕсли;
        Если СтрокаУслуги.Цена = 0 Тогда СтрокаУслуги.Цена = СтрокаУслуги.Услуга.Стоимость; КонецЕсли;
        СтрокаУслуги.Сумма = СтрокаУслуги.Количество * СтрокаУслуги.Цена;
        СуммаДополнительныхУслуг = СуммаДополнительныхУслуг + СтрокаУслуги.Сумма;
    КонецЦикла;
    ИтоговаяСумма = СуммаПроживания + СуммаДополнительныхУслуг;
    Если ИтоговаяСумма > 30000 Тогда Сообщить("Возможна скидка на проживание"); КонецЕсли;
КонецПроцедуры
