Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)
	Записи = 0;
	Записи = Записи + ОбеспечитьОрганизацию();
	Записи = Записи + ОбеспечитьСклад("Склад №1 (оптовый)");
	Записи = Записи + ОбеспечитьСклад("Склад №2 (розничный)");
	Записи = Записи + ОбеспечитьЕдиницу("шт");
	Записи = Записи + ОбеспечитьЕдиницу("усл");

	Записи = Записи + ОбеспечитьНоменклатуру("Т-001", "Стул офисный 'Комфорт'", "шт", "Товар", 1500, 2500, "20%");
	Записи = Записи + ОбеспечитьНоменклатуру("Т-002", "Стол письменный 'Стандарт'", "шт", "Товар", 4200, 6000, "20%");
	Записи = Записи + ОбеспечитьНоменклатуру("Т-003", "Принтер лазерный HP", "шт", "Товар", 8500, 12000, "20%");
	Записи = Записи + ОбеспечитьНоменклатуру("Т-004", "Бумага А4 (5 пачек)", "шт", "Товар", 800, 1200, "20%");
	Записи = Записи + ОбеспечитьНоменклатуру("Т-005", "Доставка груза", "усл", "Услуга", 0, 1500, "20%");

	Записи = Записи + ОбеспечитьКонтрагента("ООО 'РегионСнаб'", "7709365524", "Покупатель", "Договор поставки №86 от 01.01.2025");
	Записи = Записи + ОбеспечитьКонтрагента("ООО 'Продукты 24'", "7716766974", "Покупатель", "Договор розничной купли-продажи");
	Записи = Записи + ОбеспечитьКонтрагента("ИП Петров П.П.", "7705760749", "Поставщик", "Договор поставки №80 от 15.01.2025");
	Записи = Записи + ОбеспечитьКонтрагента("ООО 'Экспресс'", "7704930502", "Поставщик", "Договор транспортных услуг");

	ПроверитьStage6(Записи);
КонецПроцедуры

Функция ОбеспечитьОрганизацию()
	Ссылка = Справочники.Организации.НайтиПоКоду("001");
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Организации.СоздатьЭлемент(); Объект.Код = "001"; Нужно = Истина;
	Иначе
		Объект = Ссылка.ПолучитьОбъект(); Нужно = Ложь;
	КонецЕсли;
	Если Объект.Наименование <> "ООО 'Меркурий'" Тогда Объект.Наименование = "ООО 'Меркурий'"; Нужно = Истина; КонецЕсли;
	Если Объект.ИНН <> "7708197273" Тогда Объект.ИНН = "7708197273"; Нужно = Истина; КонецЕсли;
	Если Объект.РасчетныйСчет <> "407028102207606104" Тогда Объект.РасчетныйСчет = "407028102207606104"; Нужно = Истина; КонецЕсли;
	Если Объект.НаименованиеКассы <> "Касса основная" Тогда Объект.НаименованиеКассы = "Касса основная"; Нужно = Истина; КонецЕсли;
	Если Нужно Тогда Объект.Записать(); Возврат 1; КонецЕсли;
	Возврат 0;
КонецФункции

Функция ОбеспечитьСклад(Имя)
	Ссылка = Справочники.Склады.НайтиПоНаименованию(Имя, Истина);
	Если Ссылка.Пустая() Тогда Объект = Справочники.Склады.СоздатьЭлемент(); Объект.Наименование = Имя; Объект.Записать(); Возврат 1; КонецЕсли;
	Возврат 0;
КонецФункции

Функция ОбеспечитьЕдиницу(Код)
	Ссылка = Справочники.ЕдиницыИзмерения.НайтиПоКоду(Код);
	Если Ссылка.Пустая() Тогда Объект = Справочники.ЕдиницыИзмерения.СоздатьЭлемент(); Объект.Код = Код; Объект.Наименование = Код; Объект.Записать(); Возврат 1; КонецЕсли;
	Возврат 0;
КонецФункции

Функция ОбеспечитьНоменклатуру(Код, Имя, КодЕдиницы, Вид, ЦенаЗакупки, ЦенаПродажи, НДС)
	Единица = Справочники.ЕдиницыИзмерения.НайтиПоКоду(КодЕдиницы);
	Если Единица.Пустая() Тогда ВызватьИсключение "STAGE6: unit missing " + КодЕдиницы; КонецЕсли;
	Ссылка = Справочники.Номенклатура.НайтиПоКоду(Код);
	Если Ссылка.Пустая() Тогда Объект = Справочники.Номенклатура.СоздатьЭлемент(); Объект.Код = Код; Нужно = Истина; Иначе Объект = Ссылка.ПолучитьОбъект(); Нужно = Ложь; КонецЕсли;
	Если Объект.Наименование <> Имя Тогда Объект.Наименование = Имя; Нужно = Истина; КонецЕсли;
	Если Объект.ЕдиницаИзмерения <> Единица Тогда Объект.ЕдиницаИзмерения = Единица; Нужно = Истина; КонецЕсли;
	Если Объект.ВидНоменклатуры <> Вид Тогда Объект.ВидНоменклатуры = Вид; Нужно = Истина; КонецЕсли;
	Если Объект.ЦенаЗакупки <> ЦенаЗакупки Тогда Объект.ЦенаЗакупки = ЦенаЗакупки; Нужно = Истина; КонецЕсли;
	Если Объект.ЦенаПродажи <> ЦенаПродажи Тогда Объект.ЦенаПродажи = ЦенаПродажи; Нужно = Истина; КонецЕсли;
	Если Объект.СтавкаНДС <> НДС Тогда Объект.СтавкаНДС = НДС; Нужно = Истина; КонецЕсли;
	Если Нужно Тогда Объект.Записать(); Возврат 1; КонецЕсли;
	Возврат 0;
КонецФункции

Функция ОбеспечитьКонтрагента(Имя, ИНН, Тип, Договор)
	Ссылка = Справочники.Контрагенты.НайтиПоНаименованию(Имя, Истина);
	Если Ссылка.Пустая() Тогда Объект = Справочники.Контрагенты.СоздатьЭлемент(); Объект.Наименование = Имя; Нужно = Истина; Иначе Объект = Ссылка.ПолучитьОбъект(); Нужно = Ложь; КонецЕсли;
	Если Объект.ИНН <> ИНН Тогда Объект.ИНН = ИНН; Нужно = Истина; КонецЕсли;
	Если Объект.ТипКонтрагента <> Тип Тогда Объект.ТипКонтрагента = Тип; Нужно = Истина; КонецЕсли;
	Если Объект.Договор <> Договор Тогда Объект.Договор = Договор; Нужно = Истина; КонецЕсли;
	Если Нужно Тогда Объект.Записать(); Возврат 1; КонецЕсли;
	Возврат 0;
КонецФункции

Процедура ПроверитьStage6(Записи)
	Если Справочники.Организации.НайтиПоКоду("001").Пустая() Тогда ВызватьИсключение "STAGE6: organization missing"; КонецЕсли;
	Если Справочники.Склады.НайтиПоНаименованию("Склад №1 (оптовый)", Истина).Пустая() Или Справочники.Склады.НайтиПоНаименованию("Склад №2 (розничный)", Истина).Пустая() Тогда ВызватьИсключение "STAGE6: warehouse missing"; КонецЕсли;
	Если Справочники.ЕдиницыИзмерения.НайтиПоКоду("шт").Пустая() Или Справочники.ЕдиницыИзмерения.НайтиПоКоду("усл").Пустая() Тогда ВызватьИсключение "STAGE6: unit missing"; КонецЕсли;
	ПроверитьНоменклатуру("Т-001", "Стул офисный 'Комфорт'", "шт", "Товар", 1500, 2500, "20%");
	ПроверитьНоменклатуру("Т-002", "Стол письменный 'Стандарт'", "шт", "Товар", 4200, 6000, "20%");
	ПроверитьНоменклатуру("Т-003", "Принтер лазерный HP", "шт", "Товар", 8500, 12000, "20%");
	ПроверитьНоменклатуру("Т-004", "Бумага А4 (5 пачек)", "шт", "Товар", 800, 1200, "20%");
	ПроверитьНоменклатуру("Т-005", "Доставка груза", "усл", "Услуга", 0, 1500, "20%");
	ПроверитьКонтрагента("ООО 'РегионСнаб'", "7709365524", "Покупатель", "Договор поставки №86 от 01.01.2025");
	ПроверитьКонтрагента("ООО 'Продукты 24'", "7716766974", "Покупатель", "Договор розничной купли-продажи");
	ПроверитьКонтрагента("ИП Петров П.П.", "7705760749", "Поставщик", "Договор поставки №80 от 15.01.2025");
	ПроверитьКонтрагента("ООО 'Экспресс'", "7704930502", "Поставщик", "Договор транспортных услуг");
	Если КоличествоНоменклатуры() <> 5 Тогда ВызватьИсключение "STAGE6: nomenclature count"; КонецЕсли;
	Если КоличествоКонтрагентов() <> 4 Тогда ВызватьИсключение "STAGE6: contragents count"; КонецЕсли;
	Путь = КаталогВременныхФайлов() + "7342510-stage6-verify.txt";
	Файл = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Файл.ЗаписатьСтроку("RESULT=PASS_STAGE6_DIRECTORIES"); Файл.ЗаписатьСтроку("WRITES=" + Строка(Записи));
	Файл.ЗаписатьСтроку("ORGANIZATIONS=1"); Файл.ЗаписатьСтроку("WAREHOUSES=2"); Файл.ЗаписатьСтроку("UNITS=2");
	Файл.ЗаписатьСтроку("NOMENCLATURE=5"); Файл.ЗаписатьСтроку("GOODS=4"); Файл.ЗаписатьСтроку("SERVICES=1");
	Файл.ЗаписатьСтроку("CONTRAGENTS=4"); Файл.ЗаписатьСтроку("CONTRACTS_AS_ATTRIBUTE=4"); Файл.Закрыть();
КонецПроцедуры

Процедура ПроверитьНоменклатуру(Код, Имя, КодЕдиницы, Вид, ЦенаЗакупки, ЦенаПродажи, НДС)
	Ссылка = Справочники.Номенклатура.НайтиПоКоду(Код); Если Ссылка.Пустая() Тогда ВызватьИсключение "STAGE6: nomenclature missing " + Код; КонецЕсли;
	Если Ссылка.Наименование <> Имя Тогда ВызватьИсключение "STAGE6: wrong name " + Код; КонецЕсли;
	Если Ссылка.ЕдиницаИзмерения.Код <> КодЕдиницы Тогда ВызватьИсключение "STAGE6: wrong unit " + Код; КонецЕсли;
	Если Ссылка.ВидНоменклатуры <> Вид Или Ссылка.ЦенаЗакупки <> ЦенаЗакупки Или Ссылка.ЦенаПродажи <> ЦенаПродажи Или Ссылка.СтавкаНДС <> НДС Тогда ВызватьИсключение "STAGE6: wrong attributes " + Код; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКонтрагента(Имя, ИНН, Тип, Договор)
	Ссылка = Справочники.Контрагенты.НайтиПоНаименованию(Имя, Истина); Если Ссылка.Пустая() Тогда ВызватьИсключение "STAGE6: contragent missing " + Имя; КонецЕсли;
	Если Ссылка.ИНН <> ИНН Или Ссылка.ТипКонтрагента <> Тип Или Ссылка.Договор <> Договор Тогда ВызватьИсключение "STAGE6: wrong contragent " + Имя; КонецЕсли;
КонецПроцедуры

Функция КоличествоНоменклатуры()
	Количество = 0; Выборка = Справочники.Номенклатура.Выбрать(); Пока Выборка.Следующий() Цикл Если Не Выборка.ПометкаУдаления Тогда Количество = Количество + 1; КонецЕсли; КонецЦикла; Возврат Количество;
КонецФункции

Функция КоличествоКонтрагентов()
	Количество = 0; Выборка = Справочники.Контрагенты.Выбрать(); Пока Выборка.Следующий() Цикл Если Не Выборка.ПометкаУдаления Тогда Количество = Количество + 1; КонецЕсли; КонецЦикла; Возврат Количество;
КонецФункции
