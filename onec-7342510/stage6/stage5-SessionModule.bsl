Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)
	Записи = 0;
	Записи = Записи + ОбеспечитьОрганизацию();
	Записи = Записи + ОбеспечитьСклад("Склад №1 (оптовый)");
	Записи = Записи + ОбеспечитьСклад("Склад №2 (розничный)");
	Записи = Записи + ОбеспечитьЕдиницу("шт");
	Записи = Записи + ОбеспечитьЕдиницу("усл");
	ПроверитьStage5(Записи);
КонецПроцедуры

Функция ОбеспечитьОрганизацию()
	Ссылка = Справочники.Организации.НайтиПоКоду("001");
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Организации.СоздатьЭлемент(); Объект.Код = "001";
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Нужно = Ссылка.Пустая();
	Если Объект.Наименование <> "ООО 'Меркурий'" Тогда Объект.Наименование = "ООО 'Меркурий'"; Нужно = Истина; КонецЕсли;
	Если Объект.ИНН <> "7708197273" Тогда Объект.ИНН = "7708197273"; Нужно = Истина; КонецЕсли;
	Если Объект.РасчетныйСчет <> "407028102207606104" Тогда Объект.РасчетныйСчет = "407028102207606104"; Нужно = Истина; КонецЕсли;
	Если Объект.НаименованиеКассы <> "Касса основная" Тогда Объект.НаименованиеКассы = "Касса основная"; Нужно = Истина; КонецЕсли;
	Если Нужно Тогда Объект.Записать(); Возврат 1; КонецЕсли;
	Возврат 0;
КонецФункции

Функция ОбеспечитьСклад(Имя)
	Ссылка = Справочники.Склады.НайтиПоНаименованию(Имя, Истина);
	Если Ссылка.Пустая() Тогда Объект = Справочники.Склады.СоздатьЭлемент(); Объект.Наименование = Имя; Объект.Записать(); Возврат 1; КонецЕсли;
	Возврат 0;
КонецФункции

Функция ОбеспечитьЕдиницу(Код)
	Ссылка = Справочники.ЕдиницыИзмерения.НайтиПоКоду(Код);
	Если Ссылка.Пустая() Тогда Объект = Справочники.ЕдиницыИзмерения.СоздатьЭлемент(); Объект.Код = Код; Объект.Наименование = Код; Объект.Записать(); Возврат 1; КонецЕсли;
	Возврат 0;
КонецФункции

Процедура ПроверитьStage5(Записи)
	Если Справочники.Организации.НайтиПоКоду("001").Пустая() Тогда ВызватьИсключение "STAGE5: organization missing"; КонецЕсли;
	Если Справочники.Склады.НайтиПоНаименованию("Склад №1 (оптовый)", Истина).Пустая() Или Справочники.Склады.НайтиПоНаименованию("Склад №2 (розничный)", Истина).Пустая() Тогда ВызватьИсключение "STAGE5: warehouse missing"; КонецЕсли;
	Если Справочники.ЕдиницыИзмерения.НайтиПоКоду("шт").Пустая() Или Справочники.ЕдиницыИзмерения.НайтиПоКоду("усл").Пустая() Тогда ВызватьИсключение "STAGE5: unit missing"; КонецЕсли;
	Путь = КаталогВременныхФайлов() + "7342510-stage5-verify.txt";
	Файл = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Файл.ЗаписатьСтроку("RESULT=PASS_STAGE5_PRIMARY_SETTINGS"); Файл.ЗаписатьСтроку("WRITES=" + Строка(Записи)); Файл.Закрыть();
КонецПроцедуры
